<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#CC171212"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Retro Relay"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingBottom="6dp" />

    <!-- Linha 1: canais 1–4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_canal_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="1"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="#44FFFFFF"
            android:padding="4dp" />

        <Button
            android:id="@+id/btn_canal_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="2"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="#44FFFFFF"
            android:padding="4dp" />

        <Button
            android:id="@+id/btn_canal_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="3"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="#44FFFFFF"
            android:padding="4dp" />

        <Button
            android:id="@+id/btn_canal_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="4"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="#44FFFFFF"
            android:padding="4dp" />

    </LinearLayout>

    <!-- Linha 2: canais 5–8 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_canal_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="5"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="#44FFFFFF"
            android:padding="4dp" />

        <Button
            android:id="@+id/btn_canal_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="6"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="#44FFFFFF"
            android:padding="4dp" />

        <Button
            android:id="@+id/btn_canal_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="7"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="#44FFFFFF"
            android:padding="4dp" />

        <Button
            android:id="@+id/btn_canal_7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="8"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="#44FFFFFF"
            android:padding="4dp" />

    </LinearLayout>

</LinearLayout>
